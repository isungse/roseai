NEXT_PUBLIC_SITE_URL=https://roseai.co.kr

# Supabase
# Get from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# HMAC key for hashing submitter IPs before storing them in
# contact_inquiries.ip_hash. Generate once per environment:
#   openssl rand -hex 32
# Optional — when unset, ip_hash is recorded as NULL and spam-pattern
# queries (group by ip_hash) lose visibility, but submissions still persist.
IP_HASH_SECRET=
